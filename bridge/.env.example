# Copie para bridge/.env e ajuste.

# Endereço do site SeniorCare (npm run dev no repositório senior-care)
SENIORCARE_URL=http://localhost:3000

# apiKey do dispositivo. Duas formas de obter:
#   a) no dashboard do SeniorCare: "Cadastrar dispositivo" (mostrada UMA vez); ou
#   b) `npm run db:seed` no repositório senior-care (cria conta demo + imprime a chave).
SENIORCARE_API_KEY=

# Porta serial do ESP32 receptor. "auto" detecta placas CP210x/CH340/FTDI/Espressif.
# No Windows costuma ser COM3, COM4...; no Linux /dev/ttyUSB0.
SERIAL_PORT=auto
